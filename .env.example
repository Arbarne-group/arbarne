# ─── App ──────────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO

# ─── Database ─────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=fff
POSTGRES_PASSWORD=fff_dev
POSTGRES_DB=fff
DATABASE_URL=postgresql+psycopg2://fff:fff_dev@postgres:5432/fff

# ─── Redis / Celery ───────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ─── LLM (Anthropic Claude) ─────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-5
LLM_DAILY_TOKEN_BUDGET=200000
LLM_MONTHLY_TOKEN_BUDGET=5000000

# ─── Auth (Week 2, optional) ─────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ─── Frontend (served by FastAPI in pilot) ────────────────────────────
FRONTEND_DIR=../frontend
