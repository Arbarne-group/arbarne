generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String               @id @default(cuid())
  futureFarmId        String?              @unique
  name                String
  firstName           String?
  middleName          String?
  lastName            String?
  businessName        String?
  email               String               @unique
  passwordHash        String
  phone               String?
  phoneCountryCode    String?
  phoneNational       String?
  countryCode         String?
  country             Country?             @relation(fields: [countryCode], references: [initials])
  role                String               @default("FFFarmer")
  otherRoleLabel      String?
  accountStatus       String               @default("VERIFIED")
  authProvider        String               @default("password")
  farmingType         String?
  lastSeenAt          DateTime?
  farmName            String?
  businessId          String?              @unique
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  aspiration          Aspiration?
  assessments         Assessment[]
  businessExperience  BusinessExperience?
  digitalPlatform     DigitalPlatform?
  farmCharacteristics FarmCharacteristics?
  farmLocation        FarmLocation?
  farmManagement      FarmManagement?
  farmerProfile       FarmerProfile?
  farmingSystem       FarmingSystem?
  goalsPriorities     GoalsPriorities?
  householdLabour     HouseholdLabour?
  onboardingStatus    OnboardingStatus?
  operatingStyle      OperatingStyle?
  orders              Order[]
  subscriptions       Subscription[]
  business            Business?
  supportTickets      SupportTicket[]
}

// ─── Farm business identity (own table, FK → User) ─────────────────
// The business lives here — never mixed into the User identity row.
// (User.businessName / User.businessId are legacy fallbacks only.)
model Business {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String?  @unique // generated, e.g. FFF-KE-000-001
  businessName String?
  farmName   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model FarmerProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  jobTitle        String?
  valueChain      String?
  experienceYears String?
  businessHistory String?
  educationLevel  String?
  education       String?
  otherEducation  String?
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FarmManagement {
  id                    String   @id @default(cuid())
  userId                String   @unique
  mgmtAbility           String?
  operationsResponsible String?
  opsResponsibility     String?
  operators             String?
  otherOperator         String?
  desiredInvolvement    String?
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OperatingStyle {
  id                    String   @id @default(cuid())
  userId                String   @unique
  decisionStyle         String?
  failureResponse       String?
  obstacles             String?
  otherObstacle         String?
  guidancePreference    String?
  trackingFrequency     String?
  updatePreferences     String?
  updatePreference      String?
  communicationChannels String?
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DigitalPlatform {
  id                 String   @id @default(cuid())
  userId             String   @unique
  supportReasons     String?
  otherSupportReason String?
  remoteConfidence   String?
  remoteComfort      String?
  recordKeeping      String?
  physicalAudits     String?
  additionalNotes    String?
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Aspiration {
  id                          String   @id @default(cuid())
  userId                      String   @unique
  twelveMonthSuccess          String?
  greatestImpactSupport       String?
  marketInsight               String?
  threeToFiveYearRole         String?
  managerResponsibilities     String?
  fmResponsibility            String?
  handoverResponsibilities    String?
  personallyApprovedDecisions String?
  twentyFiveYearVision        String?
  developmentPriorities       String?
  updatedAt                   DateTime @updatedAt
  user                        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FarmLocation {
  id             String   @id @default(cuid())
  userId         String   @unique
  locationSearch String?
  country        String?
  county         String?
  subcounty      String?
  ward           String?
  landmark       String?
  latitude       Float?
  longitude      Float?
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FarmCharacteristics {
  id              String   @id @default(cuid())
  userId          String   @unique
  farmSize        Float?
  farmUnit        String?  @default("Acres")
  cultivatedAcres Float?
  grazingAcres    Float?
  landTenure      String?
  ownershipType   String?
  waterSources    String?
  soilTested      String?
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FarmingSystem {
  id                 String   @id @default(cuid())
  userId             String   @unique
  enterprises        String?
  enterpriseCore     String?
  enterpriseStrategic String?
  enterpriseStrategicOther String?
  enterpriseCashFlow String?
  enterpriseCashFlowOther String?
  cultivationMethod  String?
  mechanizationSetup String?
  energySource       String?
  irrigationMethod   String?
  irrigationOther    String?
  storageFacilities  String?
  processingFacilities String?
  processingOther    String?
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BusinessExperience {
  id                   String   @id @default(cuid())
  userId               String   @unique
  commercialYears      String?
  annualRevenueBracket String?
  recordKeepingMethod  String?
  produceBuyers        String?
  marketType           String?
  registrationStatus   String?
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GoalsPriorities {
  id                    String   @id @default(cuid())
  userId                String   @unique
  goals                 String?
  operationalBottleneck String?
  advisoryMode          String?
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model HouseholdLabour {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  permanentWorkers        Int?     @default(0)
  seasonalWorkers         Int?     @default(0)
  familyLabour            Int?     @default(0)
  managementStructure     String?
  fairEmploymentPractices String?
  updatedAt               DateTime @updatedAt
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OnboardingStatus {
  id              String    @id @default(cuid())
  userId          String    @unique
  stage           String    @default("INITIAL_IN_PROGRESS")
  profileApproved Boolean   @default(false)
  completedAt     DateTime?
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Order {
  id                    String        @id @default(cuid())
  userId                String
  planType              String
  amount                Float
  currency              String        @default("KES")
  paymentMethod         String
  phoneNumber           String?
  status                String        @default("COMPLETED")
  checkoutRequestId     String?
  merchantRequestId     String?
  mpesaReceiptNumber    String?
  paystackReference     String?       @unique
  paystackTransactionId String?
  planCode              String?
  subscriptionId        String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime?     @updatedAt
  subscription          Subscription? @relation(fields: [subscriptionId], references: [id])
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                 String    @id @default(cuid())
  userId             String
  planId             String
  planCode           String?
  subscriptionCode   String?   @unique
  emailToken         String?
  customerCode       String?
  status             String    @default("ACTIVE")
  amount             Float
  currency           String    @default("KES")
  interval           String    @default("monthly")
  currentPeriodStart DateTime  @default(now())
  currentPeriodEnd   DateTime?
  nextPaymentDate    DateTime?
  authorizationCode  String?
  cardLast4          String?
  cardBrand          String?
  cardExpMonth       String?
  cardExpYear        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  orders             Order[]
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model Assessment {
  id                  String               @id @default(cuid())
  userId              String
  overallScore        Int                  @default(0)
  maturityLevel       String               @default("Emerging")
  pillarScores        String               @default("[]")
  radarData           String               @default("[]")
  priorityAreas       String               @default("[]")
  status              String               @default("IN_PROGRESS")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @default(now()) @updatedAt
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessmentResponses AssessmentResponse[]
  ffvEvidences        FfvEvidence[]
  pillarAssessments   PillarAssessment[]
}

model PillarAssessment {
  id               String     @id @default(cuid())
  assessmentId     String
  pillarId         Int
  pillarName       String
  score            Float      @default(0)
  yesCount         Int        @default(0)
  noCount          Int        @default(0)
  totalQuestions   Int        @default(25)
  maturityLevel    String     @default("Emerging")
  capabilityScores String     @default("{}")
  isCompleted      Boolean    @default(false)
  completedAt      DateTime?
  updatedAt        DateTime   @default(now()) @updatedAt
  assessment       Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, pillarId])
  @@index([assessmentId, pillarId])
}

model AssessmentResponse {
  id               String     @id @default(cuid())
  assessmentId     String
  pillarId         Int
  capabilityId     String
  capabilityName   String?
  questionId       String
  questionText     String
  answer           String
  recommendation   String?
  whyItMatters     String?
  quickWin         String?
  supportAvailable String?
  priority         String?
  updatedAt        DateTime   @default(now()) @updatedAt
  assessment       Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, questionId])
  @@index([assessmentId, pillarId])
}

model FfvEvidence {
  id           String     @id @default(cuid())
  assessmentId String
  pillarId     Int
  capabilityId String
  questionId   String
  claimText    String?
  evidenceType String     @default("digital")
  fileName     String?
  fileType     String?
  fileSize     Int?
  fileData     String?
  notes        String?
  status       String     @default("submitted")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  media        FfvMedia[]

  @@unique([assessmentId, questionId])
  @@index([assessmentId, pillarId])
}

// One verification question accepts up to 5 separate media files.
model FfvMedia {
  id         String      @id @default(cuid())
  evidenceId String
  evidence   FfvEvidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  fileName   String
  fileType   String?
  fileSize   Int?
  fileData   String
  createdAt  DateTime    @default(now())

  @@index([evidenceId])
}

// ─── Geographic hierarchy (composite primary keys) ───────────────

model Country {
  initials  String  @id // e.g. "KE"
  name      String // e.g. "Kenya"
  dialCode  String // e.g. "+254"
  flagEmoji String? // e.g. "🇰🇪"

  counties CountyOrProvince[]
  users    User[]
}

model CountyOrProvince {
  countryCode String
  code        String // county/province code, unique per country
  name        String

  country Country @relation(fields: [countryCode], references: [initials], onDelete: Cascade)
  towns      Town[]
  subCounties SubCounty[]

  @@id([countryCode, code])
  @@index([countryCode])
}

// A sub-county (Kenya: constituency). Sits between the county/province and
// the ward, and is the level the farm profile actually asks farmers for.
model SubCounty {
  countryCode String
  countyCode  String
  code        String // sub-county code, unique per county/province
  name        String

  county CountyOrProvince @relation(fields: [countryCode, countyCode], references: [countryCode, code], onDelete: Cascade)

  @@id([countryCode, countyCode, code])
  @@index([countryCode, countyCode])
}

model Town {
  countryCode String
  countyCode  String
  code        String // town code, unique per county/province
  name        String

  county CountyOrProvince @relation(fields: [countryCode, countyCode], references: [countryCode, code], onDelete: Cascade)

  @@id([countryCode, countyCode, code])
  @@index([countryCode, countyCode])
}

// ─── Auth: verification codes, password resets, invites ──────────

model EmailVerification {
  id         String    @id @default(cuid())
  email      String    @unique
  publicId   String    @unique // dashless UUID used in /verify/<id> links
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  lastSentAt DateTime  @default(now())
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Invite {
  id             String    @id @default(cuid())
  email          String    @unique
  role           String
  otherRoleLabel String?
  tokenHash      String    @unique
  expiresAt      DateTime
  invitedById    String?
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([invitedById])
}

// ─── Audit trail (every create/update/delete) ────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  at        DateTime @default(now())
  actorId   String?
  action    String // CREATE | UPDATE | DELETE
  model     String
  recordId  String
  before    String?
  after     String?
  ip        String?

  @@index([model, recordId])
  @@index([actorId])
  @@index([at])
}

// ─── Support tickets ─────────────────────────────────────────────
// Farmers raise tickets (pillar support, FFMI/24, Learning, FFV,
// Opportunity Desk, Services Desk, General Inquiry). Clients track them
// via the emailed slug link; staff resolve them in /a/* later.
model SupportTicket {
  id           String   @id @default(cuid())
  ticketNumber String   @unique // human-readable, e.g. TKT-8F3K2A
  slug         String   @unique // tracking link, e.g. tkt-a1b2c3d4e5
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     String
  subject      String
  message      String
  status       String   @default("open") // open | in_progress | resolved | closed
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, status])
  @@index([status])
}

// ─── Opportunity Desk ────────────────────────────────────────────
// Events, partner offers, programmes… linked to the capabilities they
// strengthen. capabilityIds is a JSON array of "P1.1"-style ids; empty
// means general (shown to everyone).
model Opportunity {
  id            String    @id @default(cuid())
  key           String    @unique // stable seed key, e.g. "nakuru-dairy-field-day"
  title         String
  type          String    // event | offer | programme | market | finance
  partner       String?
  description   String
  capabilityIds String    @default("[]")
  location      String?
  startsAt      DateTime?
  endsAt        DateTime?
  linkUrl       String?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([active])
}

// ─── Digital Learning ────────────────────────────────────────────
// Blogs, documents, videos… linked to capabilities. capabilityIds is a
// JSON array of "P1.1"-style ids; empty means general.
model LearningMaterial {
  id            String   @id @default(cuid())
  key           String   @unique
  title         String
  kind          String   // blog | document | video | audio
  capabilityIds String   @default("[]")
  summary       String?
  url           String?
  duration      String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([active])
}

// ─── Solutions Hub ───────────────────────────────────────────────
// Everything Future Farms offers directly: training & extension,
// soil/water lab testing, irrigation design, cold-chain, market linkage…
model Solution {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  tagline     String?
  description String
  category    String?
  contact     String?
  linkUrl     String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
}
